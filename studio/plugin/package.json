{
  "name": "@linkmind/dsh-studio",
  "version": "0.4.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "dsh": "0.2.2-rc.2"
  },
  "main": "./desktop-host.mjs",
  "exports": {
    ".": "./desktop-host.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-files"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "linux"
      ]
    }
  },
  "description": "LinkMind\uff1aDSH \u539f\u751f\u4f1a\u8bdd\u4e2d\u7684\u5177\u8eab\u9879\u76ee\u5f00\u53d1\u3001\u8fd0\u884c\u4e0e\u5b9e\u65f6\u6444\u50cf\u5934",
  "files": [
    "*.mjs",
    "client.js",
    "backend",
    "examples",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2"
  }
}
